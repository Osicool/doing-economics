---
import { getProjects } from '../../lib/projects';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const projects = await getProjects();
const topics = [...new Set(projects.map(p => p.data.topic))].sort();
---
<Base title="Projects" description="All Doing Economics projects.">
  <h1>Projects</h1>
  <p class="muted">Doing Economics lets you learn economics by practising it: each project takes a real question, gives you real data, and has you work through it step by step so you build the skills to find, analyse and interpret evidence yourself.</p>
  <div class="filters" role="group" aria-label="Filter by topic">
    <button data-topic="all" aria-pressed="true">All</button>
    {topics.map(t => <button data-topic={t} aria-pressed="false">{t}</button>)}
  </div>
  <div class="grid">
    {projects.map(p => <ProjectCard project={p} />)}
  </div>
</Base>
<style>
  h1 { margin: 2rem 0 .75rem; }
  .grid { display: grid; gap: 1rem; grid-auto-rows: 1fr; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  .filters { display: flex; gap: .5rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
  .filters button { font: inherit; font-size: .9rem; padding: .3rem .9rem; border-radius: 99px; border: 1px solid var(--line); background: var(--card); color: var(--fg); cursor: pointer; transition: color .2s ease, background-color .2s ease, border-color .2s ease; }
  .filters button[aria-pressed="false"]:focus-visible { color: var(--purple-text); border-color: var(--purple); background: color-mix(in srgb, var(--purple) 14%, var(--card)); }
  .filters button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .filters button[aria-pressed="true"]:focus-visible { background: var(--purple); border-color: var(--purple); color: #fff; }
  @media (hover: hover) {
    .filters button[aria-pressed="false"]:hover { color: var(--purple-text); border-color: var(--purple); background: color-mix(in srgb, var(--purple) 14%, var(--card)); }
    .filters button[aria-pressed="true"]:hover { background: var(--purple); border-color: var(--purple); color: #fff; }
  }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const items = document.querySelectorAll<HTMLElement>('.grid > [data-topic]');
  buttons.forEach(b => b.addEventListener('click', () => {
    buttons.forEach(o => o.setAttribute('aria-pressed', String(o === b)));
    items.forEach(i => { i.hidden = b.dataset.topic !== 'all' && i.dataset.topic !== b.dataset.topic; });
  }));
</script>
