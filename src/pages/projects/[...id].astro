---
import { render } from 'astro:content';
import { getProjects, base } from '../../lib/projects';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}
const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const toc = headings.filter(h => h.depth === 2);
---
<Base title={project.data.title} description={project.data.summary}>
  <a class="back" href={`${base}/#projects`}>← All projects</a>
  <header class="head">
    <span class="tag">{project.data.topic}</span><span class="tag">{project.data.level}</span>
    <h1>{project.data.title}</h1>
    <p class="muted lede">{project.data.summary}</p>
    <p class="meta"><b>Tools:</b> {project.data.tools.join(', ')}{project.data.dataset && <> · <b>Data:</b> {project.data.dataset}</>}</p>
  </header>
  <div class="layout">
    {toc.length > 0 && (
      <aside aria-label="On this page"><b>On this page</b>
        <ul>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </aside>
    )}
    <article class="prose"><Content /></article>
  </div>
  <nav class="pager" aria-label="Project navigation">
    {prev ? <a href={`${base}/projects/${prev.id}/`}>← {prev.data.title}</a> : <span />}
    {next ? <a href={`${base}/projects/${next.id}/`}>{next.data.title} →</a> : <span />}
  </nav>
</Base>
<style>
  .back { display: inline-block; margin-top: 1.5rem; text-decoration: none; }
  .head { padding: 1rem 0 1.5rem; border-bottom: 1px solid var(--line); } .lede { font-size: 1.15rem; max-width: 44rem; }
  .meta { font-size: .9rem; color: var(--muted); }
  .layout { display: grid; gap: 2rem; grid-template-columns: 1fr; padding-top: 1.5rem; }
  aside { font-size: .9rem; } aside ul { list-style: none; padding: 0; margin: .4rem 0; } aside li { margin: .3rem 0; } aside a { text-decoration: none; }
  @media (min-width: 60rem) { .layout { grid-template-columns: 14rem 1fr; } aside { position: sticky; top: 1rem; align-self: start; } }
  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }
</style>
